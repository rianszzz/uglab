# UGLab Configuration Example
# PERINGATAN: Ekstensi Chrome berjalan di client-side (browser).
# Jangan pernah men-commit API Key asli Anda ke dalam git repository!
# API Key untuk UGLab dikonfigurasi langsung melalui Popup Ekstensi (disimpan lokal di chrome.storage.local).

# SambaNova Cloud API Key (Dapatkan di https://cloud.sambanova.ai/)
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# Groq API Key (Opsional / Alternatif jika menggunakan model Groq)
GROQ_API_KEY=your_groq_api_key_here
