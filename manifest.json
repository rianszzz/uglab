{
  "manifest_version": 3,
  "name": "UGLab",
  "version": "2.1.1",
  "description": "Auto-jawab soal praktikum Gunadarma (iLab & v-class) — API Mode (endpoint OpenAI-compatible) atau Web Mode (Gemini/ChatGPT/Claude)",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "activeTab",
    "windows",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "https://ujian.gunadarma.ac.id/*",
    "https://praktikum.gunadarma.ac.id/*",
    "https://v-class.gunadarma.ac.id/*",
    "https://elearning.gunadarma.ac.id/*",
    "https://generativelanguage.googleapis.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "*://172.18.18.34/*",
    "https://colab.research.google.com/*",
    "https://colab.google/*",
    "https://jupyter.org/*",
    "*://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ujian.gunadarma.ac.id/*",
        "https://praktikum.gunadarma.ac.id/*",
        "https://v-class.gunadarma.ac.id/*",
        "https://elearning.gunadarma.ac.id/*",
        "*://172.18.18.34/*"
      ],
      "js": [
        "src/lms-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://colab.research.google.com/*",
        "https://colab.google/*",
        "https://jupyter.org/*",
        "*://localhost/*"
      ],
      "js": [
        "src/notebook-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://jupyter.org/*"
      ],
      "js": [
        "src/jupyter-expose.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/ai-injector.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
